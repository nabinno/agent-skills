#!/usr/bin/env node
// Print or check the Chrome DevTools WebSocket URL. Does not open a CDP
// session unless invoked with no flags (that execs `agent-browser connect`).
// Host selection lives in platform.mjs.

import { spawnSync } from "node:child_process";
import { checkTcp, chromeWebSocketUrl, hostKind } from "./platform.mjs";

const hint =
  hostKind() === "wsl"
    ? "Chromeは自動起動しません。WSLのmirrored設定とChromeのリモートデバッグ設定を確認してください。"
    : "Chromeは自動起動しません。Chromeのリモートデバッグ設定を確認してください。";

try {
  const url = chromeWebSocketUrl();
  const args = process.argv.slice(2);
  if (args.includes("--url")) {
    console.log(url);
  } else if (args.includes("--check")) {
    await checkTcp(url);
    console.log("ChromeのCDPポートに到達できます（ブラウザ側の接続許可は未確認）。");
  } else if (args.length === 0) {
    const found = spawnSync("agent-browser", ["connect", url], { stdio: "inherit", windowsHide: true });
    if (found.error) {
      console.error("agent-browserがPATHに見つかりません。");
      process.exit(1);
    }
    process.exit(found.status ?? 1);
  } else {
    console.error("usage: cdp [--url|--check]");
    process.exit(2);
  }
} catch (error) {
  console.error(error.message ?? error);
  console.error(hint);
  process.exit(1);
}
