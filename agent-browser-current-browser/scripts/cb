#!/usr/bin/env node
// cb — run agent-browser against the user's current Chrome in an
// isolated, tab-pinned session, optionally scoped to a Chrome profile and a
// tab group, so several agents can work concurrently without colliding.
// Host differences (macOS, Windows PowerShell, WSL) live in platform.mjs.
//
//   cb new                                   default: a new group "🤖 cb-…" in the last active
//                                            profile (ungrouped tab if cb-bridge isn't there)
//   cb new --no-group                        unscoped: fresh pinned tab without a group
//   cb new --group "調査" [--profile Work]    scope = an existing tab group (main use)
//   cb new --own-group [TITLE] [--profile Work] [--new-window]
//                                            scope = a new group created for this agent
//                                            (in the profile's last used window, or a new one)
//   cb profiles                              profiles, cb-bridge status and tab groups
//   cb install-bridge                        copy cb-bridge for "Load unpacked"
//   cb hub [status|start|stop]               the shared Chrome connection (see cb-hub.mjs)
//
//   cb <session> <agent-browser args...>     run a command in the session (scope-checked)
//   cb <session> tab list | tab <tN> | tab new [url] | tab close [tN]
//   cb <session> scope                       show the session's scope
//   cb <session> allow <tN>                  add an out-of-scope tab (only on the user's say-so)
//   cb <session> show                        bring the session's tab to the front (only when asked)
//   cb <session> done [--close]              detach the session; tabs stay open unless --close
//
// Slack permalinks given to open/goto/navigate/tab new are rewritten to the web
// client (app.slack.com/client/…) so they don't hand off to the desktop app.
//
// Everything runs in background tabs: cb never activates a tab or window on its
// own (that steals focus and flashes the Windows taskbar).
//
// Scoping is a guardrail against mistakes, not a security boundary: the CDP
// connection itself can control the whole browser.
//
// Profile/tab-group information comes from the cb-bridge extension (../cb-bridge),
// reached over CDP. Profiles are identified by matching the signed-in email it
// reports against Chrome's "Local State".

import { randomBytes } from "node:crypto";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { bridgeDir, chromeUserDataDir, chromeWebSocketUrl, displayPath, pidAlive, run as hostRun, spawnDetached } from "./platform.mjs";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BRIDGE_DIR = path.resolve(HERE, "../cb-bridge");
const BRIDGE_ID = "haagbfgnipgidagcllndobiiiejdnpjl"; // fixed by manifest "key"
const TIMEOUT_S = Number(process.env.CB_TIMEOUT ?? 25);
function run(cmd, args, opts = {}) {
  return hostRun(cmd, args, { timeout: TIMEOUT_S, ...opts });
}
const CACHE_DIR = path.join(process.env.XDG_CACHE_HOME ?? path.join(os.homedir(), ".cache"), "cb");
const STATE_DIR = path.join(CACHE_DIR, "sessions");
const HUB_SCRIPT = path.join(HERE, "cb-hub.mjs");
const HUB_STATE = path.join(CACHE_DIR, "hub.json");
const HUB_LOG = path.join(CACHE_DIR, "hub.log");
const HUB_LOCK = path.join(CACHE_DIR, "hub.lock");
const HUB_WAIT_MS = 150_000;
const SESSION_RE = /^cb-[A-Za-z0-9_-]+$/;
const BRIDGE_MIN_VERSION = [0, 2, 0];
const versionOk = (v) => {
  const a = String(v).split(".").map(Number);
  for (let i = 0; i < 3; i++) if ((a[i] ?? 0) !== BRIDGE_MIN_VERSION[i]) return (a[i] ?? 0) > BRIDGE_MIN_VERSION[i];
  return true;
};

class CbError extends Error {}
const die = (msg) => {
  throw new CbError(msg);
};

// ---------------------------------------------------------------- helpers

const sleepSync = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);

// The real Chrome endpoint (only cb-hub connects to it).
function chromeUrl() {
  try {
    return chromeWebSocketUrl();
  } catch (error) {
    die(`could not resolve Chrome's CDP URL (is remote debugging enabled?)\n${error.message}`);
  }
}

function readHub() {
  try {
    const st = JSON.parse(fs.readFileSync(HUB_STATE, "utf8"));
    if (pidAlive(st.pid)) return st;
  } catch {}
  return null;
}

// Every new CDP connection makes Chrome ask "Allow remote debugging?". So cb
// and all agent-browser daemons connect through one long-lived cb-hub, which
// holds the single (approved once) connection to Chrome. Started on demand;
// it exits when Chrome quits or debugging is turned off.
function startHub() {
  fs.mkdirSync(CACHE_DIR, { recursive: true, mode: 0o700 });
  const deadline = Date.now() + HUB_WAIT_MS;
  let lock;
  while (lock === undefined) {
    const hub = readHub();
    if (hub) return hub;
    try {
      lock = fs.openSync(HUB_LOCK, "wx"); // only one cb starts the hub (one dialog)
    } catch {
      const st = fs.statSync(HUB_LOCK, { throwIfNoEntry: false });
      if (st && Date.now() - st.mtimeMs > HUB_WAIT_MS) fs.rmSync(HUB_LOCK, { force: true });
      if (Date.now() > deadline) die("timed out waiting for another cb to connect to Chrome");
      sleepSync(500);
    }
  }
  try {
    const hub = readHub();
    if (hub) return hub;
    let child;
    try {
      child = spawnDetached(process.execPath, [HUB_SCRIPT, chromeUrl(), HUB_STATE, HUB_LOG]);
    } catch (error) {
      die(`could not start cb-hub: ${error.message}`);
    }
    process.stderr.write(
      'cb: connecting to Chrome. If Chrome asks "Allow remote debugging?", allow it once; cb reuses this connection from now on.\n',
    );
    while (Date.now() < deadline) {
      const h = readHub();
      if (h) return h;
      if (!pidAlive(child.pid))
        die(`Chrome refused the connection (permission dialog denied, dismissed or timed out?). See ${HUB_LOG}`);
      sleepSync(300);
    }
    die("timed out waiting for Chrome's remote-debugging permission");
  } finally {
    fs.closeSync(lock);
    fs.rmSync(HUB_LOCK, { force: true });
  }
}

let CDP_URL;
function cdpUrl() {
  if (CDP_URL) return CDP_URL;
  if (process.env.CB_NO_HUB) return (CDP_URL = chromeUrl()); // debugging only: prompts on every connection
  return (CDP_URL = (readHub() ?? startHub()).url);
}

function cmdHub(sub = "status") {
  const hub = readHub();
  if (sub === "status") {
    if (!hub) return console.log("cb-hub: not running (starts on the next cb command)");
    console.log(`cb-hub: running (pid ${hub.pid}) -> ${hub.upstream}`);
  } else if (sub === "stop") {
    if (hub) process.kill(hub.pid, "SIGTERM");
    console.log(hub ? "cb-hub: stopped (the next cb command reconnects and Chrome asks once)" : "cb-hub: not running");
  } else if (sub === "start") {
    console.log(`cb-hub: running (pid ${(hub ?? startHub()).pid})`);
  } else die("usage: cb hub [status|start|stop]");
}

function ab(session, args, opts) {
  return run("agent-browser", ["--session", session, ...args], opts);
}

function abJson(session, args) {
  const r = ab(session, [...args, "--json"]);
  let j;
  try {
    j = JSON.parse(r.out);
  } catch {
    die(`agent-browser ${args.join(" ")} failed: ${(r.err || r.out).trim()}`);
  }
  if (!j.success) die(`agent-browser ${args.join(" ")} failed: ${JSON.stringify(j.error ?? j)}`);
  return j.data;
}

const abTabs = (session) => abJson(session, ["tab", "list"]).tabs;

function localStateProfiles() {
  const ls = JSON.parse(fs.readFileSync(path.join(chromeUserDataDir(), "Local State"), "utf8"));
  return Object.entries(ls.profile?.info_cache ?? {}).map(([dir, v]) => ({
    dir,
    name: v.name ?? "",
    email: (v.user_name ?? "").toLowerCase(),
  }));
}

// ---------------------------------------------------------------- CDP

class Cdp {
  // Chrome occasionally stalls a new CDP handshake; retry a few times.
  static async open(url, attempts = 3) {
    for (let i = 1; ; i++) {
      try {
        return await Cdp.#openOnce(url);
      } catch (e) {
        if (i >= attempts) throw e;
        await new Promise((r) => setTimeout(r, 500 * i));
      }
    }
  }
  static async #openOnce(url) {
    const c = new Cdp();
    c.ws = new WebSocket(url);
    c.id = 0;
    c.pending = new Map();
    c.ws.onmessage = (e) => {
      const m = JSON.parse(e.data);
      const p = m.id && c.pending.get(m.id);
      if (!p) return;
      c.pending.delete(m.id);
      clearTimeout(p.timer);
      m.error ? p.reject(new CbError(`CDP ${p.method}: ${m.error.message}`)) : p.resolve(m.result);
    };
    try {
      await new Promise((res, rej) => {
        const t = setTimeout(() => rej(new CbError("CDP connect timed out")), 15_000);
        c.ws.onopen = () => (clearTimeout(t), res());
        c.ws.onerror = () => (clearTimeout(t), rej(new CbError("CDP connect failed")));
      });
    } catch (e) {
      c.ws.close(); // an open/connecting socket would keep node alive
      throw e;
    }
    return c;
  }
  send(method, params = {}, sessionId) {
    const id = ++this.id;
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => {
        if (this.pending.delete(id)) reject(new CbError(`CDP ${method} timed out`));
      }, 15_000);
      this.pending.set(id, { resolve, reject, method, timer });
      this.ws.send(JSON.stringify({ id, method, params, ...(sessionId ? { sessionId } : {}) }));
    });
  }
  close() {
    this.ws.close();
  }
}

// A cb-bridge instance (one per profile it is installed in).
class Bridge {
  constructor(cdp, target, profile, info) {
    Object.assign(this, { cdp, target, profile, info, ctx: target.browserContextId });
  }
  async call(fn, arg) {
    const { sessionId } = await this.cdp.send("Target.attachToTarget", { targetId: this.target.targetId, flatten: true });
    try {
      const expr = `globalThis.cbBridge.${fn}(${arg === undefined ? "" : JSON.stringify(arg)})`;
      const r = await this.cdp.send("Runtime.evaluate", { expression: expr, awaitPromise: true, returnByValue: true }, sessionId);
      if (r.exceptionDetails) die(`cb-bridge ${fn}: ${r.exceptionDetails.exception?.description ?? r.exceptionDetails.text}`);
      return r.result.value;
    } finally {
      await this.cdp.send("Target.detachFromTarget", { sessionId }).catch(() => {});
    }
  }
}

async function connectAll() {
  const cdp = await Cdp.open(cdpUrl());
  try {
    const { targetInfos } = await cdp.send("Target.getTargets");
    const profiles = localStateProfiles();
    const bridges = [];
    for (const t of targetInfos) {
      if (t.type !== "service_worker" || !t.url.startsWith(`chrome-extension://${BRIDGE_ID}/`)) continue;
      const b = new Bridge(cdp, t, null, null);
      b.info = await b.call("info");
      if (!versionOk(b.info.version))
        die(`cb-bridge ${b.info.version} is too old (need ${BRIDGE_MIN_VERSION.join(".")}): run 'cb install-bridge', then reload it in chrome://extensions`);
      const email = b.info.email.toLowerCase();
      b.profile = profiles.find((p) => email && p.email === email) ?? { dir: "?", name: "(unknown)", email };
      bridges.push(b);
    }
    return { cdp, targets: targetInfos, profiles, bridges };
  } catch (e) {
    cdp.close(); // otherwise the open WebSocket keeps node alive
    throw e;
  }
}

function matchProfile(bridges, spec) {
  if (!spec) return bridges;
  const s = spec.toLowerCase();
  const hit = bridges.filter(
    (b) =>
      b.profile.name.toLowerCase() === s ||
      b.profile.dir.toLowerCase() === s ||
      (b.profile.email && (b.profile.email === s || b.profile.email.endsWith(`@${s.replace(/^@/, "")}`))),
  );
  if (!hit.length)
    die(`no reachable profile matches '${spec}'. Run 'cb profiles' (is that profile open and cb-bridge loaded in it?)`);
  return hit;
}

function bridgeFor(env, state) {
  const b = env.bridges.find((x) => x.profile.email && x.profile.email === state.profile.email);
  if (!b) die(`profile ${state.profile.name} <${state.profile.email}> is not reachable (closed, or cb-bridge not loaded)`);
  return b;
}

// --- scope computation ------------------------------------------------------
// The extension knows tabs by tabId, CDP/agent-browser by targetId. Without the
// debugger permission they are matched by (profile, url, title): a CDP target is
// in scope only if every tab in that profile with the same url+title is in scope.

const key = (url, title) => `${url}\u0000${title}`;

function resolveGroup(snap, state) {
  let g = snap.groups.find((x) => x.groupId === state.groupId);
  if (!g && state.groupTitle) {
    const same = snap.groups.filter((x) => x.title === state.groupTitle);
    if (same.length === 1) g = same[0];
  }
  return g ?? null;
}

async function computeScope(env, state) {
  const b = bridgeFor(env, state);
  let snap = await b.call("snapshot");
  const g = resolveGroup(snap, state);
  if (g && g.groupId !== state.groupId) {
    state.groupId = g.groupId; // ids change across browser restarts
    saveState(state);
  }
  const { targetInfos } = await env.cdp.send("Target.getTargets");
  const pages = targetInfos.filter((t) => t.type === "page" && t.browserContextId === b.ctx);
  const inScope = (t) =>
    g && (t.groupId === g.groupId || (snap.adopted[t.tabId] !== undefined && snap.adopted[t.tabId] === g.groupId));
  const total = new Map();
  const scoped = new Map(); // key -> [tabId] of in-scope tabs
  const allByKey = new Map(); // key -> [tabId] of all tabs (for allowed targets)
  for (const t of snap.tabs) {
    const k = key(t.url, t.title);
    total.set(k, (total.get(k) ?? 0) + 1);
    (allByKey.get(k) ?? allByKey.set(k, []).get(k)).push(t.tabId);
    if (inScope(t)) (scoped.get(k) ?? scoped.set(k, []).get(k)).push(t.tabId);
  }
  const targets = new Set([...(state.created ?? []).map((c) => c.targetId), ...(state.allowed ?? [])]);
  const tabIdOf = new Map((state.created ?? []).map((c) => [c.targetId, c.tabId])); // targetId -> tabId
  const ambiguous = new Set();
  for (const p of pages) {
    const k = key(p.url, p.title);
    const s = scoped.get(k)?.length ?? 0;
    if (s && s === total.get(k)) targets.add(p.targetId);
    else if (s) ambiguous.add(p.targetId);
    if (!tabIdOf.has(p.targetId) && allByKey.get(k)?.length === 1) tabIdOf.set(p.targetId, allByKey.get(k)[0]);
  }
  const alive = new Set(targetInfos.map((t) => t.targetId));
  for (const t of [...targets]) if (!alive.has(t)) targets.delete(t);
  return { bridge: b, group: g, targets, ambiguous, pages, tabIdOf };
}

// ---------------------------------------------------------------- state

const statePath = (s) => path.join(STATE_DIR, `${s}.json`);
function loadState(s) {
  try {
    return JSON.parse(fs.readFileSync(statePath(s), "utf8"));
  } catch {
    // Without state the session was never created by cb: passing it through
    // would make agent-browser launch a separate, fresh browser.
    die(`unknown session '${s}'; create one with 'cb new' (or it already ended with 'done')`);
  }
}
function saveState(st) {
  fs.mkdirSync(STATE_DIR, { recursive: true });
  fs.writeFileSync(statePath(st.session), JSON.stringify(st, null, 2));
}

// ---------------------------------------------------------------- binding

// agent-browser's own tab switch (`tab tN`) and `tab new` call Page.bringToFront /
// create a foreground tab. On Windows that steals OS focus and, when Chrome may
// not take the foreground, flashes its taskbar button (popping up an auto-hidden
// taskbar). cb therefore never uses them: it creates tabs in the background and
// binds a session by pre-writing agent-browser's per-session pin file and
// (re)starting the session's daemon, which reattaches without activating.
// Input, snapshots and screenshots all work on hidden tabs.

function socketDir() {
  if (process.env.AGENT_BROWSER_SOCKET_DIR) return process.env.AGENT_BROWSER_SOCKET_DIR;
  if (process.env.XDG_RUNTIME_DIR) return path.join(process.env.XDG_RUNTIME_DIR, "agent-browser");
  return path.join(os.homedir(), ".agent-browser");
}

function daemonAlive(dir, session) {
  try {
    process.kill(Number(fs.readFileSync(path.join(dir, `${session}.pid`), "utf8")), 0);
    return true;
  } catch {
    return false;
  }
}

// agent-browser enforces tab_locked only on its own tab switch, so check pins of
// other live sessions ourselves.
function pinnedByOther(session, targetId) {
  const dir = socketDir();
  let files = [];
  try {
    files = fs.readdirSync(dir);
  } catch {}
  for (const f of files) {
    if (!f.endsWith(".target") || f === `${session}.target`) continue;
    try {
      const j = JSON.parse(fs.readFileSync(path.join(dir, f), "utf8"));
      const owner = f.slice(0, -".target".length);
      if (j.pinned && j.targetId === targetId && daemonAlive(dir, owner)) return owner;
    } catch {}
  }
  return null;
}

function bind(session, targetId, { soft = false } = {}) {
  const owner = pinnedByOther(session, targetId);
  if (owner) {
    if (soft) return false;
    die(`tab_locked: that tab is pinned by session '${owner}'; use another tab`);
  }
  const dir = socketDir();
  if (daemonAlive(dir, session)) ab(session, ["close"]); // detach only; tabs stay open
  fs.mkdirSync(dir, { recursive: true });
  fs.writeFileSync(path.join(dir, `${session}.target`), JSON.stringify({ targetId, url: "", pinned: true }));
  const r = ab(session, ["--pin-tab", "connect", cdpUrl()]);
  if (r.code !== 0) die(`connect failed: ${(r.err || r.out).trim()}`);
  const active = abTabs(session).find((x) => x.active);
  if (active?.targetId !== targetId)
    die("agent-browser did not reattach to the requested tab (did its session file format change?)");
  return true;
}

// Background tab via plain CDP (unscoped sessions): lands in the last active
// window of the last active profile, without activating it.
async function newBackgroundTarget(state, url = "about:blank") {
  const cdp = await Cdp.open(cdpUrl());
  try {
    const { targetId } = await cdp.send("Target.createTarget", { url, background: true });
    (state.created ??= []).push({ targetId });
    saveState(state);
    return targetId;
  } finally {
    cdp.close();
  }
}

// browserContextId of the profile a plain CDP Target.createTarget lands in (the
// last active one). CDP can't tell otherwise, so open and close a background probe tab.
async function lastActiveContext(cdp) {
  const { targetId } = await cdp.send("Target.createTarget", { url: "about:blank", background: true });
  try {
    const { targetInfo } = await cdp.send("Target.getTargetInfo", { targetId });
    return targetInfo.browserContextId;
  } finally {
    await cdp.send("Target.closeTarget", { targetId }).catch(() => {});
  }
}

function resolveRef(session, ref) {
  const tabs = abTabs(session);
  const t = tabs.find((x) => x.tabId === ref || x.label === ref || x.targetId === ref);
  if (!t) die(`unknown tab '${ref}' (use '<session> tab list')`);
  return t;
}

async function waitTarget(cdp, url, ctx) {
  for (let i = 0; i < 30; i++) {
    const { targetInfos } = await cdp.send("Target.getTargets");
    const t = targetInfos.find((x) => x.type === "page" && x.url === url && x.browserContextId === ctx);
    if (t) return t.targetId;
    await new Promise((r) => setTimeout(r, 200));
  }
  die("created tab did not appear over CDP");
}

// Opens a new tab in the session's group via the bridge and binds the session to it.
async function newScopedTab(env, state, scope) {
  const marker = `about:blank#cb-${randomBytes(6).toString("hex")}`;
  const r = await scope.bridge.call("createTab", {
    url: marker,
    groupId: scope.group ? scope.group.groupId : null,
    title: state.groupTitle,
    newWindow: !!state.newWindow,
  });
  const targetId = await waitTarget(env.cdp, marker, scope.bridge.ctx);
  if (state.groupId !== r.groupId) state.groupId = r.groupId;
  (state.created ??= []).push({ tabId: r.tabId, targetId });
  saveState(state);
  bind(state.session, targetId);
  return targetId;
}

// ---------------------------------------------------------------- commands

function parseNewArgs(argv) {
  const o = { profile: null, group: null, own: false, ownTitle: null, newWindow: false, noGroup: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--profile") o.profile = argv[++i];
    else if (a === "--no-group") o.noGroup = true;
    else if (a === "--group") o.group = argv[++i];
    else if (a === "--new-window") o.newWindow = true;
    else if (a === "--own-group") {
      o.own = true;
      if (argv[i + 1] && !argv[i + 1].startsWith("--")) o.ownTitle = argv[++i];
    } else die(`unknown option for new: ${a}`);
  }
  if (o.group && o.own) die("use either --group or --own-group, not both");
  if (o.noGroup && (o.group || o.own || o.profile || o.newWindow))
    die("--no-group cannot be combined with --group/--own-group/--profile/--new-window");
  if (o.profile && !o.group) o.own = true;
  // default (no options): an own group in the last active profile, if cb-bridge is there
  o.auto = !o.noGroup && !o.group && !o.own;
  if (o.auto) o.own = true;
  return o;
}

async function cmdNew(argv) {
  const o = parseNewArgs(argv);
  const session = `cb-${new Date().toISOString().replace(/\D/g, "").slice(4, 14)}-${randomBytes(3).toString("hex")}`;
  cdpUrl();

  const unscoped = async (note) => {
    const state = { session, mode: "unscoped", created: [] };
    saveState(state);
    try {
      bind(session, await newBackgroundTarget(state));
    } catch (e) {
      ab(session, ["close"]);
      fs.rmSync(statePath(session), { force: true });
      throw e;
    }
    if (note) console.error(`cb: ${note}`);
    console.log(session);
  };
  if (o.noGroup) return unscoped();

  const env = await connectAll();
  try {
    if (!env.bridges.length) {
      if (o.auto) return await unscoped("cb-bridge is not reachable in any profile, so this session works in an ungrouped tab");
      die("cb-bridge is not reachable in any profile. See 'cb install-bridge'.");
    }
    let cands = matchProfile(env.bridges, o.profile);
    if (o.auto && cands.length > 1) {
      // Pick the profile a plain CDP tab would land in (the last active one), as unscoped sessions did.
      const ctx = await lastActiveContext(env.cdp);
      const hit = cands.filter((b) => b.ctx === ctx);
      if (!hit.length)
        return await unscoped("cb-bridge is not loaded in the last active profile, so this session works in an ungrouped tab");
      cands = hit;
    }
    const state = { session, mode: o.own ? "own-group" : "group", created: [], allowed: [] };
    let bridge, group;
    if (o.group) {
      const hits = [];
      for (const b of cands) for (const g of (await b.call("snapshot")).groups) if (g.title === o.group) hits.push({ b, g });
      if (!hits.length) die(`no tab group titled '${o.group}'${o.profile ? ` in ${o.profile}` : ""}. Run 'cb profiles'.`);
      if (hits.length > 1)
        die(`'${o.group}' matches ${hits.length} groups (${hits.map((h) => h.b.profile.name).join(", ")}); add --profile`);
      ({ b: bridge, g: group } = hits[0]);
    } else {
      if (cands.length > 1) die(`several profiles are open (${cands.map((b) => b.profile.name).join(", ")}); add --profile`);
      bridge = cands[0];
    }
    if (!bridge.profile.email) die("that profile is not signed in to Chrome, so cb cannot identify it");
    Object.assign(state, {
      profile: bridge.profile,
      groupId: group?.groupId ?? null,
      groupTitle: group?.title ?? o.ownTitle ?? `🤖 ${session}`,
      newWindow: o.own && o.newWindow,
    });

    saveState(state);

    if (o.own) {
      await newScopedTab(env, state, { bridge, group: null });
    } else {
      const scope = await computeScope(env, state);
      const snap = await bridge.call("snapshot");
      const order = snap.tabs.filter((t) => t.groupId === group.groupId).sort((a, b) => b.active - a.active || a.index - b.index);
      // agent-browser hides chrome:// etc. pages (e.g. a group's New Tab), so only pick tabs it can drive
      const drivable = (u) => /^(https?|file|data):|^about:blank/.test(u);
      const cand = order
        .filter((t) => drivable(t.url))
        .map((t) => scope.pages.find((p) => p.url === t.url && p.title === t.title && scope.targets.has(p.targetId)))
        .filter(Boolean);
      // skip tabs another agent has pinned; if none is free, work in a fresh tab inside the group
      let bound = false;
      for (const p of cand) if ((bound = bind(session, p.targetId, { soft: true }))) break;
      if (!bound) await newScopedTab(env, state, scope);
    }
    console.log(session);
  } catch (e) {
    ab(session, ["close"]);
    fs.rmSync(statePath(session), { force: true });
    throw e;
  } finally {
    env.cdp.close();
  }
}

async function cmdProfiles() {
  const env = await connectAll();
  try {
    const seen = new Set();
    for (const b of env.bridges) {
      seen.add(b.profile.email);
      const snap = await b.call("snapshot");
      console.log(`● ${b.profile.name} <${b.profile.email || "not signed in"}> [${b.profile.dir}] cb-bridge ${b.info.version}`);
      for (const g of snap.groups) {
        const n = snap.tabs.filter((t) => t.groupId === g.groupId).length;
        console.log(`    group "${g.title}" (${g.color}, ${n} tabs)`);
      }
      const loose = snap.tabs.filter((t) => t.groupId === -1).length;
      console.log(`    (${loose} ungrouped tabs)`);
    }
    for (const p of env.profiles)
      if (!seen.has(p.email)) console.log(`○ ${p.name} <${p.email}> [${p.dir}] not open, or cb-bridge not loaded`);
  } finally {
    env.cdp.close();
  }
}

function cmdInstallBridge() {
  const dest = bridgeDir();
  fs.mkdirSync(dest, { recursive: true });
  for (const f of ["manifest.json", "background.js"]) fs.copyFileSync(path.join(BRIDGE_DIR, f), path.join(dest, f));
  const shown = displayPath(dest);
  console.log(`copied cb-bridge to ${shown}
In EACH Chrome profile you want to scope to:
  1. open chrome://extensions and turn on Developer mode
  2. "Load unpacked" -> ${shown}   (after updates: click the reload icon instead)
Extension id should be ${BRIDGE_ID}. Then check with: cb profiles`);
}

// `done` keeps the session's tabs open (the user reviews them afterwards);
// `done --close` closes the tabs cb opened. The user's own tabs are never closed.
function doneCloses(argv) {
  for (const a of argv.slice(1)) if (a !== "--close") die(`unknown option for done: ${a} (only --close)`);
  return argv.includes("--close");
}

function releaseState(session) {
  fs.rmSync(statePath(session), { force: true });
  fs.rmSync(path.join(socketDir(), `${session}.target`), { force: true });
}

const BLOCKED = new Set(["--all", "--cdp", "--session", "--no-pin-tab", "--auto-connect", "connect"]);

async function cmdSession(session, argv) {
  if (!SESSION_RE.test(session)) die(`session name must look like cb-xxxx (got '${session}'); create one with 'cb new'`);
  if (!argv.length) die("missing agent-browser command");
  for (const a of argv) if (BLOCKED.has(a)) die(`'${a}' is not allowed via cb (it would escape this session)`);
  if (argv[0] === "close") die("use 'done' to end the session");
  const state = loadState(session);

  if (state.mode === "unscoped") {
    if (argv[0] === "done") {
      const close = doneCloses(argv);
      ab(session, ["close"]); // detach first, then close the tabs cb opened (no tab switching)
      if (close) {
        const cdp = await Cdp.open(cdpUrl());
        try {
          for (const c of state.created ?? []) await cdp.send("Target.closeTarget", { targetId: c.targetId }).catch(() => {});
        } finally {
          cdp.close();
        }
      }
      releaseState(session);
      console.log(`cb: session ${session} released (${close ? "closed the tabs it opened" : "its tabs stay open"})`);
      return;
    }
    if (argv[0] === "scope" || argv[0] === "allow") die("this session is unscoped (created with --no-group, or where cb-bridge was unavailable)");
    const [cmd, sub, arg] = argv;
    if (cmd === "show") return showTab(session, null);
    if (cmd === "tab" && sub === "new") {
      bind(session, await newBackgroundTarget(state));
      if (arg) passthrough(session, ["open", arg]);
      console.log("cb: opened a new background tab");
      return;
    }
    if (cmd === "tab" && sub && !["list", "close"].includes(sub) && !sub.startsWith("-")) {
      const t = resolveRef(session, sub);
      bind(session, t.targetId);
      console.log(`cb: switched to ${sub} - ${t.url}`);
      return;
    }
    await primeIfNeeded(state, session, argv);
    passthrough(session, argv);
    return;
  }

  const env = await connectAll();
  let code = 0;
  try {
    const scope = await computeScope(env, state);
    const [cmd, sub, arg] = argv;

    if (cmd === "done") {
      const close = doneCloses(argv);
      const created = close ? (state.created ?? []).filter((c) => scope.pages.some((p) => p.targetId === c.targetId)) : [];
      if (created.length) await scope.bridge.call("closeTabs", created.map((c) => c.tabId));
      ab(session, ["close"]); // detaches only; user's tabs stay open
      releaseState(session);
      console.log(
        `cb: session ${session} released (${close ? `closed ${created.length} tab(s) it opened` : `its tabs stay open in "${state.groupTitle}"`})`,
      );
      return;
    }
    if (cmd === "show") return showTab(session, scope);
    if (cmd === "scope") {
      console.log(`profile: ${state.profile.name} <${state.profile.email}>`);
      console.log(`group:   "${state.groupTitle}" ${scope.group ? "" : "(gone)"} mode=${state.mode}`);
      printTabs(session, scope);
      return;
    }
    if (cmd === "allow") {
      if (!sub) die("usage: allow <tN>");
      const t = resolveRef(session, sub);
      (state.allowed ??= []).push(t.targetId);
      saveState(state);
      console.log(`cb: ${sub} (${t.url}) added to scope of ${session}`);
      return;
    }
    if (cmd === "tab") {
      if (!sub || sub === "list") return printTabs(session, scope);
      if (sub === "new") {
        if (!scope.group && state.mode === "group") die(`group "${state.groupTitle}" no longer exists`);
        await newScopedTab(env, state, scope);
        if (arg) code = passthrough(session, ["open", arg], false);
        else console.log("cb: opened a new tab in scope");
        return;
      }
      if (sub === "close") {
        const t = arg ? resolveRef(session, arg) : abTabs(session).find((x) => x.active);
        const c = (state.created ?? []).find((x) => x.targetId === t?.targetId);
        if (!c) die("cb only closes tabs it opened itself; ask the user to close other tabs");
        await scope.bridge.call("closeTabs", [c.tabId]);
        state.created = state.created.filter((x) => x !== c);
        saveState(state);
        const next = await computeScope(env, state);
        const rest = [...next.targets];
        if (t.active && rest.length) bind(session, rest[rest.length - 1]);
        console.log(`cb: closed ${t.tabId}${t.active && !rest.length ? "; no tab left in scope, use 'tab new'" : ""}`);
        return;
      }
      if (sub && !sub.startsWith("-")) {
        const t = resolveRef(session, sub);
        if (scope.ambiguous.has(t.targetId))
          die(`${sub} has the same URL and title as a tab outside the scope; cb cannot tell them apart. Ask the user to close the duplicate.`);
        if (!scope.targets.has(t.targetId)) die(`${sub} is outside this session's scope ("${state.groupTitle}")`);
        bind(session, t.targetId);
        console.log(`cb: switched to ${sub} - ${t.url}`);
        return;
      }
    }

    const active = abTabs(session).find((x) => x.active);
    if (active && scope.ambiguous.has(active.targetId))
      die(
        `the session's current tab (${active.tabId}) has the same URL and title as a tab outside "${state.groupTitle}",\n` +
          "so cb cannot confirm it is in scope. Ask the user to close the duplicate, or use another in-scope tab.",
      );
    if (!active || !scope.targets.has(active.targetId))
      die(
        `the session's current tab is outside its scope ("${state.groupTitle}") or gone.\n` +
          "Use 'tab list' and 'tab <tN>' to pick an in-scope tab, or 'tab new <url>'.",
      );
    await primeIfNeeded(state, session, argv, active.targetId, env.cdp);
    code = passthrough(session, argv, false);
  } finally {
    env.cdp.close();
  }
  process.exitCode = code;
}

// A background tab that has never been shown has no rendered frame, so Chrome
// drops pointer input (clicks "succeed" but never reach the page). Capturing a
// 1x1 screenshot renders a frame without activating the tab or its window.
const POINTER_INPUT = new Set([
  "click", "dblclick", "hover", "drag", "mouse", "check", "uncheck", "select",
  "scroll", "scrollintoview", "upload", "download", "find", "focus", "press", "keyboard", "type", "fill",
]);
const PRIME_TTL_MS = 30_000;

async function primeIfNeeded(state, session, argv, targetId, sharedCdp) {
  if (!POINTER_INPUT.has(argv[0])) return;
  targetId ??= abTabs(session).find((x) => x.active)?.targetId;
  if (!targetId) return;
  const primed = (state.primed ??= {});
  if (Date.now() - (primed[targetId] ?? 0) < PRIME_TTL_MS) return;
  const cdp = sharedCdp ?? (await Cdp.open(cdpUrl()));
  try {
    const { sessionId } = await cdp.send("Target.attachToTarget", { targetId, flatten: true });
    await cdp
      .send("Page.captureScreenshot", { clip: { x: 0, y: 0, width: 1, height: 1, scale: 1 } }, sessionId)
      .catch(() => {});
    await cdp.send("Target.detachFromTarget", { sessionId }).catch(() => {});
  } finally {
    if (!sharedCdp) cdp.close();
  }
  primed[targetId] = Date.now();
  saveState(state);
}

// Only on the user's request ("見せて"): bring the session's tab to the front of
// its window so they can watch it. Never used automatically.
async function showTab(session, scope) {
  const active = abTabs(session).find((x) => x.active);
  if (!active) die("the session has no tab");
  const tabId = scope?.tabIdOf.get(active.targetId);
  if (tabId !== undefined) await scope.bridge.call("activateTab", tabId);
  else {
    const cdp = await Cdp.open(cdpUrl());
    try {
      await cdp.send("Target.activateTarget", { targetId: active.targetId });
    } finally {
      cdp.close();
    }
  }
  console.log(`cb: showing ${active.tabId} - ${active.url}`);
}

function printTabs(session, scope) {
  for (const t of abTabs(session)) {
    if (!scope.targets.has(t.targetId) && !scope.ambiguous.has(t.targetId)) continue;
    const mark = t.active ? "→" : " ";
    const amb = scope.ambiguous.has(t.targetId) ? " (ambiguous: duplicate outside scope)" : "";
    console.log(`${mark} [${t.tabId}] ${t.title} - ${t.url}${amb}`);
  }
}

// ---------------------------------------------------------------- Slack links

// Slack permalinks (https://<ws>.slack.com/archives/C…/p…) land on a page that
// hands off to the desktop app via slack://, which pops a Windows dialog/the app
// instead of showing the message. The web client takes
//   https://app.slack.com/client/<team>/<channel>[/thread/<channel>-<thread_ts>]
// directly and stays in the browser. The team id comes from the web client's own
// localStorage (localConfig_v2), read in the session's tab and cached.
const SLACK_TEAMS = path.join(CACHE_DIR, "slack-teams.json");
const SLACK_PERMALINK = /^https:\/\/([a-z0-9-]+(?:\.enterprise)?)\.slack\.com\/archives\/([A-Z0-9]+)(?:\/p(\d{10})(\d{6}))?\/?(?:[?#]|$)/i;
const OPEN_CMDS = new Set(["open", "goto", "navigate"]);

function readSlackTeams() {
  try {
    return JSON.parse(fs.readFileSync(SLACK_TEAMS, "utf8"));
  } catch {
    return {};
  }
}

function slackTeamId(session, host) {
  const cached = readSlackTeams()[host];
  if (cached) return cached;
  // app.slack.com/client opens the last used workspace in the browser (no app hand-off)
  const o = ab(session, ["open", "https://app.slack.com/client"], { timeout: Math.max(TIMEOUT_S, 40) });
  if (o.code !== 0) return null;
  const expr =
    "JSON.stringify(Object.values(JSON.parse(localStorage.localConfig_v2||'{}').teams||{}).map(t=>[t.url,t.id]))";
  let pairs = [];
  for (let i = 0; i < 10 && !pairs.length; i++) {
    const r = ab(session, ["eval", expr, "--json"]);
    try {
      pairs = JSON.parse(JSON.parse(r.out).data.result);
    } catch {}
    if (!pairs.length) sleepSync(1000);
  }
  const teams = readSlackTeams();
  for (const [url, id] of pairs) {
    try {
      if (id) teams[new URL(url).hostname] = id;
    } catch {}
  }
  fs.mkdirSync(CACHE_DIR, { recursive: true, mode: 0o700 });
  fs.writeFileSync(SLACK_TEAMS, JSON.stringify(teams, null, 2), { mode: 0o600 });
  return teams[host] ?? null;
}

// Returns the web-client URL for a Slack permalink, or the input unchanged.
function slackWebUrl(session, url) {
  const m = SLACK_PERMALINK.exec(url ?? "");
  if (!m) return url;
  const host = `${m[1].toLowerCase()}.slack.com`;
  const [, , channel, sec, usec] = m;
  const team = slackTeamId(session, host);
  if (!team) {
    console.error(`cb: no Slack team id for ${host} (not signed in to it in this profile?); opening the permalink as is`);
    return url;
  }
  const q = new URL(url).searchParams;
  const threadTs = q.get("thread_ts") ?? (sec ? `${sec}.${usec}` : null);
  const out = `https://app.slack.com/client/${team}/${q.get("cid") ?? channel}${threadTs ? `/thread/${q.get("cid") ?? channel}-${threadTs}` : ""}`;
  console.error(`cb: Slack permalink -> ${out} (web client, not the desktop app)`);
  return out;
}

// Rewrites the URL argument of open/goto/navigate when it is a Slack permalink.
function rewriteOpen(session, argv) {
  if (!OPEN_CMDS.has(argv[0])) return argv;
  const i = argv.findIndex((a, k) => k > 0 && !a.startsWith("-"));
  if (i < 0) return argv;
  const url = slackWebUrl(session, argv[i]);
  return url === argv[i] ? argv : argv.with(i, url);
}

function passthrough(session, argv, exit = true) {
  argv = rewriteOpen(session, argv);
  const r = run("agent-browser", ["--session", session, ...argv], { timeout: TIMEOUT_S, stdio: "inherit" });
  if (exit) process.exit(r.code ?? 1);
  return r.code ?? 1;
}

// ---------------------------------------------------------------- main

const [first, ...rest] = process.argv.slice(2);
try {
  if (!first || first === "-h" || first === "--help") {
    const src = fs.readFileSync(fileURLToPath(import.meta.url), "utf8").split("\n");
    console.log(src.slice(1, src.findIndex((l) => l.startsWith("import"))).map((l) => l.replace(/^\/\/ ?/, "")).join("\n").trim());
  } else if (first === "new") await cmdNew(rest);
  else if (first === "profiles" || first === "groups") await cmdProfiles();
  else if (first === "install-bridge") cmdInstallBridge();
  else if (first === "hub") cmdHub(rest[0]);
  else await cmdSession(first, rest);
} catch (e) {
  if (!(e instanceof CbError)) throw e;
  console.error(`cb: ${e.message}`);
  process.exitCode = 1;
}
process.exit(process.exitCode ?? 0);
