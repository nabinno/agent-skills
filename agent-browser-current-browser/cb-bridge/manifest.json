{
  "manifest_version": 3,
  "name": "cb-bridge (agent-browser scope helper)",
  "version": "0.2.0",
  "description": "Lets the agent-skills `cb` wrapper scope agent-browser sessions to a Chrome profile and tab group. No UI, no content scripts, no network access.",
  "key": "",
  "minimum_chrome_version": "144",
  "permissions": ["tabs", "tabGroups", "storage", "identity", "identity.email"],
  "background": { "service_worker": "background.js" }
}
